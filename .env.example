# Copy to .env locally. Never commit credential values.
BROWSERBASE_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional: your own iMessage number for an explicitly approved one-time setup.
PHOTON_TEST_RECIPIENT=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
TYPESAFE_API_KEY=

# Shared trip backend; set this to the backend teammate's real service URL.
API_BASE_URL=

# Optional standalone menu adapter. Localhost is the default.
MENU_FETCH_HOST=127.0.0.1
MENU_FETCH_PORT=8101
# Required when exposing the menu adapter beyond localhost.
MENU_FETCH_TOKEN=
MENU_FETCH_BASE_URL=http://127.0.0.1:8101

# Jev scoring configuration (the key is listed above).
JEV_MODEL=jev-latest
YES_MIN_CONFIDENCE=0.8

# Optional Photon state location; use persistent private storage on deployment.
# PHOTON_STATE_PATH=

# Optional voice bridge configuration.
VOICE_HOST=127.0.0.1
VOICE_PORT=8788
# Set the exact frontend origin when serving voice on a different origin.
VOICE_ALLOWED_ORIGIN=http://localhost:3000
